# Optional overrides for docker-compose.yml (copy to .env next to it).
FRONTEND_PORT=3000
# Which address the web app listens on. 127.0.0.1 (default) = only this machine; use HTTPS
# (Tailscale serve, Caddy) to reach it from your phone. 0.0.0.0 serves plain HTTP to your whole
# network, so passwords cross it unencrypted: not advised.
# FRONTEND_BIND=127.0.0.1
BACKEND_PORT=8000
# Reverse proxy in front of FinTrack? Its IP/CIDR, comma-separated (see frontend/docker/).
# Example for a proxy on this machine reaching Docker's published port: 172.16.0.0/12
# TRUSTED_PROXIES=
# DATABASE_URL=postgresql+psycopg://fintrack:fintrack@postgres:5432/fintrack
# POSTGRES_PASSWORD=change-me
