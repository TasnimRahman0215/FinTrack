# Rendered at container start: ${BACKEND_URL} comes from the environment.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # API calls go to the backend container (same origin for the browser => cookies just work).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;  # a first sync can take a while
    }

    # Hashed build assets can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths serve index.html (never cached, so updates show up).
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
