# Copy to .env and fill in. Generate secrets with:  fintrack gen-keys
#   (Docker: docker compose run --rm backend fintrack gen-keys)

# Required for anything beyond local dev
SECRET_KEY=
# Encrypts SimpleFIN credentials at rest. Back it up: if it changes, saved connections stop working.
ENCRYPTION_KEY=

# Local development only. In Docker this line is ignored: docker-compose.yml sets DATABASE_URL
# (to use Postgres there, put DATABASE_URL in the .env next to docker-compose.yml instead).
# Postgres example: postgresql+psycopg://fintrack:fintrack@localhost:5432/fintrack
DATABASE_URL=sqlite:///./data/fintrack.db

# Set to false once everyone in your household has signed up (invite links will still work).
# While it's true, anyone who can reach the server can create an account (in their own,
# separate household), so keep it short-lived if the server is reachable from the internet.
ALLOW_SIGNUP=true

# The SimpleFIN servers FinTrack may contact (comma-separated; subdomains included).
# SIMPLEFIN_ALLOWED_HOSTS=simplefin.org

# Only needed if the frontend is served from a different origin than the API. Exact origins,
# comma-separated; "*" is refused.
# CORS_ORIGINS=https://fintrack.example.com
# When serving over HTTPS (Tailscale serve, a domain...), set this. Over plain HTTP, passwords
# and session cookies cross your network unencrypted, so use HTTPS beyond localhost.
# COOKIE_SECURE=true
# Cross-site frontend + API needs: COOKIE_SAMESITE=none and COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Sessions end after SESSION_DAYS without use, and after SESSION_MAX_DAYS no matter what.
# SESSION_DAYS=30
# SESSION_MAX_DAYS=90

# How many password hashes may run at once (~64 MiB of RAM each). Keep it low on small machines.
# PASSWORD_HASH_CONCURRENCY=2

# Background sync. Keep RUN_SCHEDULER=true unless you run the separate worker container.
RUN_SCHEDULER=true
SYNC_INTERVAL_HOURS=6
SYNC_COOLDOWN_MINUTES=15
# "Sync now" runs per connection per day (SimpleFIN allows about 24 requests/day/connection).
SYNC_MANUAL_DAILY_LIMIT=12
INITIAL_SYNC_DAYS=90

LOG_LEVEL=INFO
